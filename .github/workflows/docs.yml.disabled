name: Deploy Documentation

on:
  push:
    branches:
      - main
    paths:
      - 'docs-site/**'
      - 'mkdocs.yml'
      - 'requirements-docs.txt'
      - 'agenkit-ts/src/**'
      - 'agenkit-ts/typedoc.json'
      - 'agenkit-cpp/include/**'
      - 'agenkit-cpp/Doxyfile'
      - '.github/workflows/docs.yml'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # Python setup for MkDocs
      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.13'

      - name: Cache Python dependencies
        uses: actions/cache@v3
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ hashFiles('requirements-docs.txt') }}
          restore-keys: |
            ${{ runner.os }}-pip-

      - name: Install Python dependencies
        run: |
          pip install -r requirements-docs.txt

      # Node.js setup for TypeDoc
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'
          cache-dependency-path: 'agenkit-ts/package-lock.json'

      - name: Install TypeScript dependencies
        run: |
          cd agenkit-ts
          npm ci

      - name: Generate TypeScript API docs
        run: |
          cd agenkit-ts
          npm run docs
          echo "TypeScript docs generated to agenkit-ts/docs/"

      # Doxygen setup for C++
      - name: Install Doxygen
        run: |
          sudo apt-get update
          sudo apt-get install -y doxygen graphviz

      - name: Generate C++ API docs
        run: |
          cd agenkit-cpp
          doxygen Doxyfile
          echo "C++ docs generated to agenkit-cpp/docs/api/html/"

      # Merge all docs into MkDocs site structure
      - name: Prepare multi-language API site
        run: |
          # Create API docs directories in the site output
          mkdir -p site/ts-api
          mkdir -p site/cpp-api

          # Copy TypeScript docs
          if [ -d "agenkit-ts/docs" ]; then
            cp -r agenkit-ts/docs/* site/ts-api/
            echo "✅ TypeScript API docs copied to site/ts-api/"
          else
            echo "⚠️  TypeScript docs not found"
          fi

          # Copy C++ docs
          if [ -d "agenkit-cpp/docs/api/html" ]; then
            cp -r agenkit-cpp/docs/api/html/* site/cpp-api/
            echo "✅ C++ API docs copied to site/cpp-api/"
          else
            echo "⚠️  C++ docs not found"
          fi

          # Create index redirects for better UX
          echo '<meta http-equiv="refresh" content="0; url=./index.html">' > site/ts-api/index.htm || true
          echo '<meta http-equiv="refresh" content="0; url=./index.html">' > site/cpp-api/index.htm || true

      # Build MkDocs site (includes Python API docs via mkdocstrings)
      - name: Build MkDocs site
        run: |
          mkdocs build --verbose

          # Verify all API docs are in place
          echo "📊 Documentation structure:"
          ls -la site/ | head -20
          echo ""
          echo "TypeScript API:"
          ls -la site/ts-api/ | head -10 || echo "Not found"
          echo ""
          echo "C++ API:"
          ls -la site/cpp-api/ | head -10 || echo "Not found"

      # Update API reference pages with links to generated docs
      - name: Update API reference links
        run: |
          # TypeScript API page update
          if [ -f "docs-site/api/typescript.md" ] && [ -d "site/ts-api" ]; then
            echo "✅ TypeScript API docs ready at https://agenkit.dev/ts-api/"
          fi

          # C++ API page update
          if [ -d "site/cpp-api" ]; then
            # Update C++ API reference page to add link
            cat >> docs-site/api/cpp.md.tmp << 'EOF'

[📚 View C++ API Documentation](https://agenkit.dev/cpp-api/){ .md-button .md-button--primary }

EOF
            if ! grep -q "View C++ API Documentation" docs-site/api/cpp.md; then
              # Insert link after "Official Documentation" section
              sed -i.bak '/^## Official Documentation$/,/^---$/ {
                /^---$/ i\
\
[📚 View C++ API Documentation](https://agenkit.dev/cpp-api/){ .md-button .md-button--primary }
              }' docs-site/api/cpp.md && rm docs-site/api/cpp.md.bak || true
            fi
            echo "✅ C++ API docs ready at https://agenkit.dev/cpp-api/"
          fi

      # Configure Git for deployment
      - name: Configure Git
        run: |
          git config user.name github-actions[bot]
          git config user.email github-actions[bot]@users.noreply.github.com

      # Deploy to GitHub Pages
      - name: Deploy to GitHub Pages
        run: |
          # MkDocs gh-deploy handles the deployment
          mkdocs gh-deploy --force --message "docs: Deploy documentation [skip ci]"
          echo "✅ Documentation deployed to https://agenkit.dev"

      # Create deployment summary
      - name: Create deployment summary
        if: always()
        run: |
          echo "## 📚 Documentation Deployment Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "| Component | Status | URL |" >> $GITHUB_STEP_SUMMARY
          echo "|-----------|--------|-----|" >> $GITHUB_STEP_SUMMARY

          # Main site
          echo "| Main Site | ✅ Deployed | https://agenkit.dev |" >> $GITHUB_STEP_SUMMARY

          # Python API
          echo "| Python API | ✅ Deployed | https://agenkit.dev/api/python/ |" >> $GITHUB_STEP_SUMMARY

          # TypeScript API
          if [ -d "site/ts-api" ]; then
            echo "| TypeScript API | ✅ Deployed | https://agenkit.dev/ts-api/ |" >> $GITHUB_STEP_SUMMARY
          else
            echo "| TypeScript API | ⚠️ Skipped | N/A |" >> $GITHUB_STEP_SUMMARY
          fi

          # C++ API
          if [ -d "site/cpp-api" ]; then
            echo "| C++ API | ✅ Deployed | https://agenkit.dev/cpp-api/ |" >> $GITHUB_STEP_SUMMARY
          else
            echo "| C++ API | ⚠️ Skipped | N/A |" >> $GITHUB_STEP_SUMMARY
          fi

          # Other languages
          echo "| Go API | ✅ Auto-published | https://pkg.go.dev/github.com/scttfrdmn/agenkit/agenkit-go |" >> $GITHUB_STEP_SUMMARY
          echo "| Rust API | ✅ Auto-published | https://docs.rs/agenkit |" >> $GITHUB_STEP_SUMMARY

          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**Note**: Go and Rust APIs auto-publish to their respective platforms." >> $GITHUB_STEP_SUMMARY
