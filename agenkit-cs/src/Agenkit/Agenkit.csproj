<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>Agenkit</PackageId>
    <Version>0.92.0</Version>
    <Authors>Agenkit Contributors</Authors>
    <Description>Minimal, composable interfaces for AI agents — C#/.NET</Description>
    <PackageTags>ai;agents;llm;anthropic;openai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RootNamespace>Agenkit</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <!-- System.Text.Json is part of the net10.0 shared framework; an explicit
         PackageReference is redundant and raises NU1510. -->

  </ItemGroup>
</Project>
