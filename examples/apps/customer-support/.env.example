# LLM Configuration
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Service Configuration
PYTHON_API_HOST=0.0.0.0
PYTHON_API_PORT=8000
GO_WORKER_GRPC_HOST=go-worker
GO_WORKER_GRPC_PORT=50051

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=customer-support
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686

# Middleware Configuration
# Timeout (seconds)
TIMEOUT_DEFAULT=5.0
TIMEOUT_RAG=30.0
TIMEOUT_FAQ=3.0

# Rate Limiting (per user)
RATE_LIMIT_USER_RATE=10.0
RATE_LIMIT_USER_CAPACITY=20
RATE_LIMIT_GLOBAL_RATE=100.0
RATE_LIMIT_GLOBAL_CAPACITY=200

# Caching
CACHE_MAX_SIZE=1000
CACHE_TTL_FAQ=300
CACHE_TTL_RAG=600

# Audit Logging
AUDIT_LOG_FILE=./logs/audit.log
AUDIT_LOG_STRUCTURED=true

# Feature Flags
ENABLE_CACHING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_TRACING=true
ENABLE_METRICS=true

# Application Settings
LOG_LEVEL=INFO
DEBUG=false
