# LLM Configuration
OPENAI_API_KEY=sk-xxxxx

# Service Configuration
PYTHON_API_PORT=8000
GO_SCRAPER_GRPC_PORT=50051

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=research_assistant
POSTGRES_USER=research
POSTGRES_PASSWORD=research_password

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=research-assistant

# Middleware Configuration
TIMEOUT_DEFAULT=60.0
TIMEOUT_SCRAPING=120.0
TIMEOUT_RESEARCH=180.0
RATE_LIMIT_USER_RATE=5.0  # 5 research requests per hour
RATE_LIMIT_USER_CAPACITY=10

# Feature Flags
ENABLE_CACHING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_TRACING=true

# Application Settings
LOG_LEVEL=INFO
DEBUG=false
MAX_RESEARCH_STEPS=10
