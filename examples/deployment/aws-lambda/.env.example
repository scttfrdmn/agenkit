# ============================================================
# AWS Lambda Environment Configuration
# ============================================================

# Deployment Configuration
ENVIRONMENT=dev                    # dev, staging, prod
AWS_REGION=us-east-1              # AWS region for deployment
AGENT_TYPE=react                  # react, conversational, router

# Runtime Selection
RUNTIME=python                    # python or go
PYTHON_RUNTIME=python3.12         # Python runtime version
MEMORY_SIZE=512                   # Lambda memory in MB (128-10240)
TIMEOUT=30                        # Lambda timeout in seconds (1-900)

# Logging Configuration
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR
LOG_RETENTION_DAYS=30             # CloudWatch log retention (1-3653)

# ============================================================
# LLM Provider API Keys
# ============================================================
# IMPORTANT: Use AWS Secrets Manager in production, not environment variables!

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4
# OPENAI_MAX_TOKENS=1000

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-sonnet-20240229
# ANTHROPIC_MAX_TOKENS=1000

# AWS Bedrock (uses IAM for authentication)
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
# BEDROCK_REGION=us-east-1

# ============================================================
# Agent Configuration
# ============================================================

# ReAct Agent Settings
REACT_MAX_STEPS=5                 # Maximum reasoning steps
REACT_VERBOSE=true                # Enable verbose logging

# Conversational Agent Settings
CONVERSATIONAL_MAX_HISTORY=10     # Maximum conversation history
CONVERSATIONAL_SYSTEM_PROMPT="You are a helpful AI assistant deployed on AWS Lambda."

# Router Agent Settings
ROUTER_DEFAULT_AGENT=react        # Default agent if routing fails

# ============================================================
# Feature Flags
# ============================================================

ENABLE_API_GATEWAY=true           # Enable API Gateway integration
ENABLE_FUNCTION_URL=true          # Enable Lambda Function URL
ENABLE_XRAY_TRACING=true          # Enable AWS X-Ray tracing
ENABLE_ALARMS=false               # Enable CloudWatch alarms
ENABLE_BEDROCK=false              # Enable AWS Bedrock access
ENABLE_SECRETS_MANAGER=false      # Enable Secrets Manager access

# ============================================================
# API Gateway Configuration
# ============================================================

API_GATEWAY_AUTH_TYPE=NONE        # NONE, AWS_IAM, CUSTOM, COGNITO_USER_POOLS
API_GATEWAY_THROTTLE_RATE=50      # Requests per second
API_GATEWAY_THROTTLE_BURST=100    # Burst capacity

# ============================================================
# Lambda Function URL Configuration
# ============================================================

FUNCTION_URL_AUTH_TYPE=NONE       # NONE or AWS_IAM
FUNCTION_URL_CORS_ORIGINS=*       # Comma-separated origins (use specific domains in prod)

# ============================================================
# CloudWatch Alarms Configuration
# ============================================================

ALARM_ERROR_THRESHOLD=10          # Errors per minute to trigger alarm
ALARM_THROTTLE_THRESHOLD=5        # Throttles per minute to trigger alarm
ALARM_DURATION_THRESHOLD=25000    # Duration in ms to trigger alarm
# ALARM_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:my-alerts

# ============================================================
# Deployment Tool Configuration
# ============================================================

# SAM Configuration
SAM_STACK_NAME=agenkit-lambda-dev # CloudFormation stack name
SAM_S3_BUCKET=                    # S3 bucket for SAM artifacts (optional)

# Terraform Configuration
TF_WORKSPACE=dev                  # Terraform workspace
TF_STATE_BUCKET=                  # S3 bucket for Terraform state (optional)
TF_STATE_KEY=agenkit-lambda/terraform.tfstate
TF_STATE_DYNAMODB_TABLE=          # DynamoDB table for state locking (optional)

# ============================================================
# Performance Optimization
# ============================================================

# Cold Start Optimization
ENABLE_PROVISIONED_CONCURRENCY=false  # Keep instances warm
PROVISIONED_CONCURRENCY_COUNT=0       # Number of warm instances

# Connection Pooling
HTTP_CLIENT_TIMEOUT=30                # HTTP client timeout in seconds
HTTP_CLIENT_MAX_CONNECTIONS=100       # Max concurrent connections

# ============================================================
# Security Configuration
# ============================================================

# Secrets Manager
OPENAI_SECRET_ARN=                    # ARN for OpenAI API key secret
ANTHROPIC_SECRET_ARN=                 # ARN for Anthropic API key secret

# VPC Configuration (if needed)
ENABLE_VPC=false                      # Enable VPC configuration
VPC_SUBNET_IDS=                       # Comma-separated subnet IDs
VPC_SECURITY_GROUP_IDS=               # Comma-separated security group IDs

# ============================================================
# Monitoring and Observability
# ============================================================

# X-Ray Sampling
XRAY_SAMPLING_RATE=1.0                # 0.0-1.0 (1.0 = 100%)

# CloudWatch Metrics
ENABLE_ENHANCED_METRICS=false         # Enable Lambda Insights

# Custom Metrics Namespace
CUSTOM_METRICS_NAMESPACE=Agenkit      # CloudWatch custom metrics namespace

# ============================================================
# Development Configuration
# ============================================================

# Local Testing
LOCAL_API_PORT=3000                   # Port for sam local start-api
LOCAL_INVOKE_EVENT=events/test-event.json

# Debug Settings
DEBUG_MODE=false                      # Enable debug logging
VERBOSE_ERRORS=false                  # Include stack traces in responses

# ============================================================
# Cost Optimization
# ============================================================

# Right-sizing
AUTO_TUNE_MEMORY=false                # Auto-tune memory based on usage (future feature)
TARGET_UTILIZATION=80                 # Target memory utilization percentage

# ============================================================
# Multi-Environment Configuration Examples
# ============================================================

# Development Environment
# ENVIRONMENT=dev
# MEMORY_SIZE=256
# ENABLE_ALARMS=false
# LOG_LEVEL=DEBUG

# Staging Environment
# ENVIRONMENT=staging
# MEMORY_SIZE=512
# ENABLE_ALARMS=true
# LOG_LEVEL=INFO

# Production Environment
# ENVIRONMENT=prod
# MEMORY_SIZE=1024
# ENABLE_ALARMS=true
# ENABLE_PROVISIONED_CONCURRENCY=true
# PROVISIONED_CONCURRENCY_COUNT=5
# LOG_LEVEL=WARNING
# FUNCTION_URL_AUTH_TYPE=AWS_IAM
# API_GATEWAY_AUTH_TYPE=AWS_IAM
