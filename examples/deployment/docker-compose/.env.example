# ============================================================
# Agenkit Docker Compose Environment Configuration
# ============================================================

# Environment
COMPOSE_PROJECT_NAME=agenkit
ENVIRONMENT=production

# ============================================================
# Agent Configuration
# ============================================================

# Python Agent
PYTHON_AGENT_TYPE=react
PYTHON_LOG_LEVEL=INFO
PYTHON_WORKERS=4

# Go Agent
GO_AGENT_TYPE=conversational
GO_LOG_LEVEL=INFO

# ============================================================
# LLM Provider API Keys
# ============================================================
# IMPORTANT: Use secrets management in production (Docker Secrets, Vault)

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=1000

# ============================================================
# Database Configuration
# ============================================================

# PostgreSQL
POSTGRES_DB=agenkit
POSTGRES_USER=agenkit
POSTGRES_PASSWORD=agenkit_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agenkit:agenkit_password@postgres:5432/agenkit

# ============================================================
# Redis Configuration
# ============================================================

REDIS_PASSWORD=agenkit_redis_password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:agenkit_redis_password@redis:6379/0

# ============================================================
# Observability Configuration
# ============================================================

# Jaeger Tracing
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1
JAEGER_REPORTER_LOG_SPANS=false

# Prometheus
PROMETHEUS_PORT=8001

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ============================================================
# Nginx Configuration
# ============================================================

NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=2048

# ============================================================
# Resource Limits
# ============================================================

# Python Agent
PYTHON_MEMORY_LIMIT=2G
PYTHON_MEMORY_RESERVATION=512M
PYTHON_CPU_LIMIT=2.0
PYTHON_CPU_RESERVATION=0.5

# Go Agent
GO_MEMORY_LIMIT=1G
GO_MEMORY_RESERVATION=256M
GO_CPU_LIMIT=1.5
GO_CPU_RESERVATION=0.25

# Redis
REDIS_MEMORY_LIMIT=512M
REDIS_MAXMEMORY=256mb

# PostgreSQL
POSTGRES_MEMORY_LIMIT=1G

# ============================================================
# Backup Configuration
# ============================================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
BACKUP_RETENTION_DAYS=30

# ============================================================
# Security Configuration
# ============================================================

# SSL/TLS (for production)
SSL_ENABLED=false
SSL_CERT_PATH=./nginx/ssl/cert.pem
SSL_KEY_PATH=./nginx/ssl/key.pem

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=100

# ============================================================
# Development Configuration
# ============================================================

DEBUG_MODE=false
HOT_RELOAD=false
