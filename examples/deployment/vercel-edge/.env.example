# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Configuration (optional, alternative to OpenAI)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Vercel KV Configuration
# These are automatically provided by Vercel when you add a KV store
# See: https://vercel.com/docs/storage/vercel-kv/quickstart
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
KV_REST_API_READ_ONLY_TOKEN=...

# Application Configuration
NEXT_PUBLIC_APP_VERSION=0.45.0
