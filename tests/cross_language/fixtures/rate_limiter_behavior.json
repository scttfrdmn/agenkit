{
  "version": "1.0",
  "description": "Cross-language rate limiter behavior test fixtures",
  "test_cases": [
    {
      "id": "rate_limiter_allows_within_capacity",
      "name": "Allows requests within burst capacity",
      "config": {
        "rate": 10.0,
        "capacity": 10,
        "tokens_per_request": 1,
        "max_wait_ms": null
      },
      "scenario": {
        "requests": [
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0}
        ]
      },
      "expected_behavior": {
        "all_successful": true,
        "total_requests": 5,
        "allowed_requests": 5,
        "rejected_requests": 0,
        "min_total_time_ms": 0,
        "max_total_time_ms": 100
      }
    },
    {
      "id": "rate_limiter_waits_for_tokens",
      "name": "Waits for tokens when capacity exceeded",
      "config": {
        "rate": 10.0,
        "capacity": 5,
        "tokens_per_request": 1,
        "max_wait_ms": null
      },
      "scenario": {
        "requests": [
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0}
        ]
      },
      "expected_behavior": {
        "all_successful": true,
        "total_requests": 6,
        "allowed_requests": 6,
        "rejected_requests": 0,
        "sixth_request_waited": true,
        "min_wait_time_ms": 80,
        "max_wait_time_ms": 150
      }
    },
    {
      "id": "rate_limiter_rejects_on_timeout",
      "name": "Rejects requests when max_wait exceeded",
      "config": {
        "rate": 2.0,
        "capacity": 2,
        "tokens_per_request": 1,
        "max_wait_ms": 100
      },
      "scenario": {
        "requests": [
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0}
        ]
      },
      "expected_behavior": {
        "all_successful": false,
        "total_requests": 3,
        "allowed_requests": 2,
        "rejected_requests": 1,
        "third_request_rejected": true
      }
    },
    {
      "id": "rate_limiter_token_refill",
      "name": "Refills tokens at configured rate",
      "config": {
        "rate": 5.0,
        "capacity": 5,
        "tokens_per_request": 1,
        "max_wait_ms": null
      },
      "scenario": {
        "steps": [
          {"action": "request"},
          {"action": "request"},
          {"action": "request"},
          {"action": "request"},
          {"action": "request"},
          {"action": "wait", "duration_ms": 600},
          {"action": "request"},
          {"action": "request"},
          {"action": "request"}
        ]
      },
      "expected_behavior": {
        "all_successful": true,
        "total_requests": 8,
        "allowed_requests": 8,
        "rejected_requests": 0,
        "tokens_refilled": true
      }
    },
    {
      "id": "rate_limiter_burst_capacity",
      "name": "Allows burst up to capacity",
      "config": {
        "rate": 5.0,
        "capacity": 10,
        "tokens_per_request": 1,
        "max_wait_ms": null
      },
      "scenario": {
        "requests": [
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0}
        ]
      },
      "expected_behavior": {
        "all_successful": true,
        "total_requests": 10,
        "allowed_requests": 10,
        "rejected_requests": 0,
        "burst_handled": true,
        "max_total_time_ms": 100
      }
    },
    {
      "id": "rate_limiter_multiple_tokens_per_request",
      "name": "Consumes multiple tokens per request",
      "config": {
        "rate": 10.0,
        "capacity": 10,
        "tokens_per_request": 3,
        "max_wait_ms": null
      },
      "scenario": {
        "requests": [
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0}
        ]
      },
      "expected_behavior": {
        "all_successful": true,
        "total_requests": 3,
        "allowed_requests": 3,
        "rejected_requests": 0,
        "tokens_consumed": 9
      }
    },
    {
      "id": "rate_limiter_metrics_tracking",
      "name": "Tracks metrics accurately",
      "config": {
        "rate": 5.0,
        "capacity": 3,
        "tokens_per_request": 1,
        "max_wait_ms": 150
      },
      "scenario": {
        "requests": [
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0},
          {"delay_ms": 0}
        ]
      },
      "expected_metrics": {
        "total_requests": 5,
        "allowed_requests": 3,
        "rejected_requests": 2,
        "total_wait_time_greater_than": 0
      }
    }
  ]
}
