{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/agenkit/agenkit/schemas/retry_config.json",
  "title": "Retry Configuration",
  "description": "Cross-language retry middleware configuration schema",
  "type": "object",
  "required": ["max_attempts"],
  "properties": {
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Maximum number of retry attempts",
      "default": 3
    },
    "initial_backoff_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Initial backoff delay in milliseconds",
      "default": 1000
    },
    "max_backoff_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Maximum backoff delay in milliseconds",
      "default": 30000
    },
    "backoff_multiplier": {
      "type": "number",
      "minimum": 1.0,
      "description": "Exponential backoff multiplier",
      "default": 2.0
    },
    "jitter": {
      "type": "boolean",
      "description": "Whether to add random jitter to backoff delays",
      "default": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "max_attempts": 3,
      "initial_backoff_ms": 1000,
      "max_backoff_ms": 30000,
      "backoff_multiplier": 2.0,
      "jitter": false
    },
    {
      "max_attempts": 5,
      "initial_backoff_ms": 100,
      "max_backoff_ms": 10000,
      "backoff_multiplier": 1.5,
      "jitter": true
    }
  ]
}
