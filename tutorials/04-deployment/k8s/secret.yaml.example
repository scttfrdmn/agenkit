# Example Kubernetes Secret (DO NOT commit real secrets!)
# Create actual secret with:
# kubectl create secret generic agent-secrets \
#   --from-literal=openai-api-key=YOUR_KEY \
#   --from-literal=anthropic-api-key=YOUR_KEY \
#   --from-literal=postgres-url=postgresql://user:pass@host:5432/db

apiVersion: v1
kind: Secret
metadata:
  name: agent-secrets
type: Opaque
stringData:
  openai-api-key: "sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
  anthropic-api-key: "sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
  postgres-url: "postgresql://postgres:password@postgres-service:5432/agenkit"
